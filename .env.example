# LiveKit Server (dev mode defaults)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# vLLM-Omni endpoint (running on GPU server), serves both /v1/chat/completions
# and /v1/realtime from the same process/port.
VLLM_BASE_URL=http://<gpu-server-ip>:8091/v1
VLLM_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
