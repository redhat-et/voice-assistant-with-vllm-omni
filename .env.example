# LiveKit Server (dev mode defaults)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# vLLM-Omni endpoint (running on GPU server), serves both /v1/chat/completions
# and /v1/realtime from the same process/port.
VLLM_BASE_URL=http://<gpu-server-ip>:8091/v1
VLLM_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct

# For Nemotron VoiceChat's model-native full-duplex mode instead: point
# VLLM_BASE_URL at a vllm-omni server running the
# nemotron_labs_voicechat_duplex deploy-config, and set
# VLLM_MODEL=nemotron-voicechat -- agent_realtime.py detects "nemotron" in
# the model name and switches to NemotronDuplexRealtimeModel automatically.
